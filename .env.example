# ReviewDesk environment template. Copy to .env and fill in.
# Never commit the real .env file.

# Required: SQLite database location
DATABASE_URL="file:../db/custom.db"

# Required: 64-char hex secret used to sign session cookies.
# Generate with: openssl rand -hex 32
APP_SECRET=""

# Optional: Google OAuth for "Connect with Google" (Business Profile scope).
# Without these, the Connect button shows an honest "needs admin setup" state
# and users can still paste an API key or access token.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to {origin}/api/auth/google/callback when unset.
GOOGLE_REDIRECT_URI=""

# Optional: SMTP for verification and password-reset emails.
# Without SMTP the app stays fully usable and shows dev links honestly.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ReviewDesk <no-reply@example.com>"
