# ReviewDesk environment template.
# Copy to .env and fill it in. Never commit the real .env file.
#
# Check what is set at any time with: npm run env:check

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string. The app does not work with SQLite.
# Neon: https://neon.tech  Supabase: https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/reviewdesk?sslmode=require"

# 64 hex characters (32 bytes). Signs the session cookie and keys the
# AES-256-GCM encryption for stored credentials.
# Generate with: openssl rand -hex 32
APP_SECRET=""

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
#
# "mock" runs the whole app offline with canned triage responses. No API
# key, no outbound request, no cost. This is what the demo and the tests
# use.
#
# Any other value makes live model calls through the Z.ai SDK, which speaks
# the OpenAI chat completions shape. Live calls cost money and the review
# text is sent to the provider.
REVIEWDESK_PROVIDER="mock"

# Only needed when REVIEWDESK_PROVIDER is not "mock".
ZAI_API_KEY=""

# ---------------------------------------------------------------------------
# Optional: Google Business Profile connection
# ---------------------------------------------------------------------------
#
# Without these, "Connect with Google" shows an honest "needs admin setup"
# state. The owner can still paste an API key or an access token from the
# Credentials screen, and the demo inbox works either way.
#
# Register {origin}/api/auth/google/callback in the Google Cloud console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to {origin}/api/auth/google/callback when unset.
GOOGLE_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# Optional: SMTP for verification and password-reset email
# ---------------------------------------------------------------------------
#
# Without SMTP the app stays fully usable and shows the one-time link in
# the interface instead of sending it.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ReviewDesk <no-reply@example.com>"
