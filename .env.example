# ReviewDesk — environment template
# Copy to .env and fill in. Never commit the real .env.

# SQLite database file (relative to the prisma folder)
DATABASE_URL="file:../db/custom.db"

# Generate with: openssl rand -base64 32
# Used to encrypt Google credentials (AES-256-GCM) and sign session cookies.
APP_SECRET=""

# ---- Optional: Google OAuth (Connect with Google) ------------------------
# Create an OAuth client in Google Cloud Console, enable the Business
# Profile APIs, and register the redirect URI:
#   {your-origin}/api/auth/google/callback
# with scope https://www.googleapis.com/auth/business.manage
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Only needed if the origin differs from the deployment URL:
GOOGLE_REDIRECT_URI=""

# ---- Optional: SMTP for verification / reset emails ----------------------
# Without SMTP the app still works: dev-only links are shown in the UI
# and logged to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ReviewDesk <no-reply@yourdomain.com>"
