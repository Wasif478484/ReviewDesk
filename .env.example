# ReviewDesk environment template. Copy to .env and fill in real values.
# Never commit a filled-in .env.

# Provider: anthropic (default) | openai | mock
REVIEWDESK_PROVIDER=anthropic

# Required for anthropic / openai. Leave unset and use REVIEWDESK_PROVIDER=mock
# to run the app with no API key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
ANTHROPIC_MODEL=claude-3-haiku-20240307
OPENAI_MODEL=gpt-4o-mini

# Local model-result cache controls
REVIEWDESK_CACHE_TTL_SECONDS=86400
REVIEWDESK_CACHE_MAX_ENTRIES=200