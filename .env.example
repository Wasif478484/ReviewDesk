# ReviewDesk environment template
# Never commit the real .env file

# Required PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/reviewdesk?sslmode=require

# Required 64-char hex secret
APP_SECRET=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ReviewDesk no-reply at example.com

# Optional LLM provider
REVIEWDESK_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
