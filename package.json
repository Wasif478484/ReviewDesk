{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": false,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node -e \"require('fs').rmSync('node_modules/.prisma',{recursive:true,force:true})\" && prisma generate && next build",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test --experimental-strip-types \"tests/*.test.ts\"",
    "test:watch": "node --import ./tests/register.mjs --test --watch --experimental-strip-types \"tests/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "env:check": "node scripts/check-env.mjs",
    "db:generate": "node -e \"require('fs').rmSync('node_modules/.prisma',{recursive:true,force:true})\" && prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "release": "npm run check && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-toast": "^1.2.14",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "nodemailer": "^10.1.2",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.3",
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.7.50",
    "eslint": "^10",
    "eslint-config-next": "^16.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Owner-in-the-loop Google review triage and reply drafting for local businesses.",
  "license": "MIT",
  "author": "ReviewDesk contributors",
  "homepage": "https://reviewdesk-nu.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wasif478484/ReviewDesk.git"
  },
  "bugs": {
    "url": "https://github.com/Wasif478484/ReviewDesk/issues"
  },
  "keywords": [
    "reviews",
    "triage",
    "google-business",
    "nextjs",
    "reply-drafts"
  ]
}