# Files that are not needed to build or run the app.
#
# Everything here is either a development-only file, a generated artifact, or
# documentation. The app itself only needs src/, prisma/, public/, and the
# config files.

# Documentation and assets that are not part of the runtime.
docs/
demo-assets/
*.md
!README.md

# Tests and maintainer scripts. The app does not import them.
tests/
scripts/

# Local tooling.
.github/
.devpost/

# Python leftovers from the original prototype.
*.py
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/
.sample_cache/
requirements.txt
pyproject.toml

# Environment files. The platform holds the real values.
.env
.env.*
!.env.example

# Build output and caches.
.next/
node_modules/
out/
dist/
coverage/
*.tsbuildinfo
.vercel

# Editor and OS.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
